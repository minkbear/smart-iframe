{
  "name": "smart-iframe",
  "version": "1.0.0",
  "description": "Smart iframe loader with auto-resize, redirect handling, and event communication",
  "main": "src/smart-iframe.js",
  "scripts": {
    "build": "npm run minify",
    "build:v2": "npm run minify:v2",
    "build:v3": "npm run minify:v3 && npm run minify:injector-v3 && npm run minify:module-v3",
    "minify": "terser src/smart-iframe.js -o dist/smart-iframe.min.js -c -m --source-map",
    "minify:v2": "terser src/smart-iframe-v2.js -o dist/smart-iframe-v2.min.js -c -m --source-map",
    "minify:v3": "terser src/smart-iframe-v3.js -o dist/smart-iframe-v3.min.js -c -m --source-map",
    "minify:injector-v3": "terser src/iframe-injector-v3.js -o dist/iframe-injector-v3.min.js -c -m --source-map",
    "minify:module-v3": "terser src/smart-iframe-inertia.js -o dist/smart-iframe-inertia.min.js -c -m --module --source-map",
    "dev": "npm run build -- --watch",
    "dev:v2": "npm run build:v2 -- --watch",
    "test": "node test/test.js",
    "test:v2": "echo 'Open tests/test-v2-functional.html in browser to test v2'",
    "test:v3": "echo 'Run npm run serve:parent + serve:iframe, then open http://localhost:8000/tests/v3/test-v3-inertia.html'",
    "serve": "npx http-server -p 8000 -c-1",
    "serve:parent": "npx http-server -p 8000 -c-1",
    "serve:iframe": "npx http-server -p 8001 -c-1",
    "serve:iframe:v3": "node tests/v3/server.js 8001",
    "serve:both": "npm run serve:parent & npm run serve:iframe"
  },
  "keywords": ["iframe", "responsive", "communication", "postmessage"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "terser": "^5.0.0"
  }
}